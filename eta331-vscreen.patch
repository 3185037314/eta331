+package io.github.mangi.eta.agent.display
+
+/**
+ * 记录「这台虚拟屏能不能拿到无障碍 UI 树」。
+ *
+ * 有些系统在同一窗口上反复返回空树，每轮观察都重试会拖慢节奏；
+ * 连续失败两次就当作不可用，只走截图 + 坐标，等换了窗口再重新试探。
+ */
+internal class VirtualScreenUiTreeAvailability(
+    private val clock: () -> Long,
+) {
+    private var scope: String? = null
+    private var failures = 0
+    private var lastWindowId: Int? = null
+
+    fun updateScope(info: VirtualDisplayInfo?) {
+        val id = info?.sessionId
+        if (id != scope) {
+            scope = id
+            failures = 0
+            lastWindowId = null
+        }
+    }
+
+    fun record(info: VirtualDisplayInfo?, windowId: Int?, hasNodes: Boolean) {
+        updateScope(info)
+        if (hasNodes) {
+            failures = 0
+        } else {
+            failures++
+        }
+        lastWindowId = windowId
+    }
+
+    fun unavailableFor(info: VirtualDisplayInfo?): Boolean {
+        if (info == null) return false
+        updateScope(info)
+        return failures >= MAX_FAILURES
+    }
+
+    private companion object {
+        const val MAX_FAILURES = 2
+    }
+}
