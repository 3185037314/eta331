+        } finally {
+            pending.getAndSet(null)?.recycle()
+        }
+    }
+
+    private fun sendInput(sessionId: String, args: JSONObject) {
+        inputError = false
+        // 走专用输入通道：单线程串行、拖动只留最新一跳，不再每个事件各起一个协程抢管道。
+        VirtualScreenInputPump.submit(applicationContext, sessionId, args) { ok ->
