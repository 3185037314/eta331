+package io.github.mangi.eta.core
+
+import android.util.Log
+
+/**
+ * 虚拟屏与后台常驻链路的轻量落盘日志。
+ *
+ * 与 logcat 的区别：写入 files/eta-trace.log，进程被杀后仍能翻到现场，
+ * 写失败一律静默，绝不因为日志拖垮主流程。
+ */
+internal object EtaTrace {
+    private const val TAG = "EtaTrace"
+    private const val MAX_BYTES = 512 * 1024L
+
+    @Volatile
+    private var file: java.io.File? = null
+
+    fun init(context: android.content.Context) {
+        runCatching {
+            val dir = java.io.File(context.filesDir, "trace")
+            dir.mkdirs()
+            file = java.io.File(dir, "eta-trace.log")
+        }
+    }
+
+    fun log(tag: String, message: String) {
+        val line = "${System.currentTimeMillis()} [$tag] $message"
+        Log.d(TAG, line)
+        val target = file ?: return
+        runCatching {
+            if (target.length() > MAX_BYTES) target.writeText("")
+            target.appendText(line + "\n")
+        }
+    }
+}
