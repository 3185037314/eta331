diff --git a/app/src/main/kotlin/io/github/mangi/eta/ui/screens/tasks/VirtualScreenSettingsScreen.kt b/app/src/main/kotlin/io/github/mangi/eta/ui/screens/tasks/VirtualScreenSettingsScreen.kt
