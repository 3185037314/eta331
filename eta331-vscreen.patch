+package io.github.mangi.eta.agent.overlay
+
+import android.content.Context
+import android.view.View
+
+/**
+ * 虚拟屏手势指示器的挂载点。
+ *
+ * 3.3.1 把指示器收敛成了 [GestureIndicator] 单例（自己挂 overlay 窗口绘制），
+ * 虚拟屏小窗那套代码按「构造时绑定 context、可 addView 的宿主 View」来写。
+ * 这里用一个空 View 满足挂载契约，真正的绘制交给单例。
+ */
+class GestureIndicatorHost(context: Context) : View(context) {
+
+    fun showPress(x: Float, y: Float, isLongPress: Boolean, durationMs: Int) {
+        if (isLongPress) {
+            GestureIndicator.showLongPress(context, x.toInt(), y.toInt(), durationMs)
+        } else {
+            GestureIndicator.showTap(context, x.toInt(), y.toInt())
+        }
+    }
+
+    fun showSwipe(x1: Float, y1: Float, x2: Float, y2: Float, durationMs: Int) {
+        GestureIndicator.showSwipe(
+            context, x1.toInt(), y1.toInt(), x2.toInt(), y2.toInt(), durationMs
+        )
+    }
+}
